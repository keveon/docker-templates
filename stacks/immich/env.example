# =======================================================================
# 镜像版本
# =======================================================================
# Immich 镜像版本（推荐使用 release 或具体版本号如 v1.120.0）
IMMICH_VERSION=release

# =======================================================================
# 基础配置
# =======================================================================
# 重启策略（no/always/on-failure/unless-stopped）
RESTART=unless-stopped

# 时区设置
TZ=Asia/Shanghai

# =======================================================================
# 存储路径配置
# =======================================================================
# 媒体文件存储路径（照片、视频、缩略图等）
# 建议预留足够空间（预估原库容量的 10-20% 额外空间）
UPLOAD_LOCATION=./upload

# 数据库存储路径
# ⚠️ 必须使用本地 SSD，不能使用网络共享（NFS、SMB 等）
# Windows 用户请使用 WSL2，并确保文件系统支持 Unix 权限（EXT4、ZFS、APFS）
DB_DATA_LOCATION=./postgres

# =======================================================================
# 数据库配置（PostgreSQL + pgvector）
# =======================================================================
# 数据库密码（必填：建议使用字母数字组合，避免特殊字符）
DB_PASSWORD=postgres

# 数据库用户名
DB_USERNAME=postgres

# 数据库名称
DB_DATABASE_NAME=immich

# 数据库主机（容器内部网络）
DB_HOSTNAME=database

# 数据库端口
DB_PORT=5432

# =======================================================================
# Redis 配置
# =======================================================================
# Redis 主机（容器内部网络）
REDIS_HOSTNAME=redis

# Redis 端口
REDIS_PORT=6379

# =======================================================================
# Immich 服务配置
# =======================================================================
# 机器学习服务配置（可选，一般情况下使用默认值即可）
# MACHINE_LEARNING_HOST=immich-machine-learning
# MACHINE_LEARNING_PORT=3003

# =======================================================================
# 高级配置（可选）
# =======================================================================
# Immich 运行环境（production/development）
# IMMICH_ENV=production

# 日志级别（verbose/debug/log/warn/error/silent）
# IMMICH_LOG_LEVEL=log

# 禁用硬件加速转码（true/false）
# DISABLE_RELOAD_ENV=false

# WebRTC 配置（用于实时协作功能）
# IMMICH_WEB_RTC_ENABLED=true

# =======================================================================
# 外部服务配置（可选）
# =======================================================================
# OAuth 提供商配置（可选）
# - 支持 Google、Facebook、Apple 等第三方登录
# - 详见官方文档：https://immich.app/docs/features/oauth

# 邮件通知配置（可选）
# - 用于发送通知、共享链接等
# - 支持 SMTP、Sendgrid 等邮件服务

# 存储桶配置（可选）
# - 用于将原始媒体文件存储到 S3、MinIO 等对象存储
# - 详见官方文档：https://immich.app/docs/administration/storage-template
